{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nagori-frame",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-20",
  "routes": [{ "pattern": "nagori-frame.m3000.io", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/",
      "/index.html",
      "/sw.js",
      "/viewer.js",
      "/viewer.css"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nagori",
      "database_id": "replace-with-d1-id",
      "migrations_dir": "../../packages/core/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "nagori-photos"
    }
  ]
}
