{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nagori-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "nagori.m3000.io", "custom_domain": true }],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "ENVIRONMENT": "development",
    "FRAME_URL": "http://localhost:8788",
    "APP_URL": "http://localhost:3000",
    "INITIAL_OWNER_EMAIL": "replace-with-owner-email"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nagori",
      "database_id": "replace-with-d1-id",
      "migrations_dir": "../../packages/core/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "nagori-photos"
    }
  ]
}
